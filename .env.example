# Local SQLite file, resolved relative to the prisma/ directory.
# On Vercel set this to a Neon Postgres URL instead, with sslmode=require.
DATABASE_URL="file:./dev.db"

# Auth.js session signing key. Use a long random value in production.
AUTH_SECRET="dala-dev-secret-change-me"
AUTH_TRUST_HOST=true

# Production only, after Vercel assigns a URL. Same origin, no path.
# AUTH_URL="https://your-project.vercel.app"
# NEXTAUTH_URL="https://your-project.vercel.app"

# Flutterwave checkout for Featured listing and Verified Pro.
# Leave these unset to keep checkout disabled. Nothing is charged until a secret key is set.
# Test secret keys start with FLWSECK_TEST. Live keys start with FLWSECK- and take real money.
# FLW_SECRET_KEY="FLWSECK_TEST-..."
# FLW_PUBLIC_KEY="FLWPUBK_TEST-..."
# The same string you save as the webhook secret hash in the Flutterwave dashboard.
# FLW_WEBHOOK_HASH="a-long-random-string"
# Public origin for the return URL. Locally this can be omitted.
# APP_URL="http://localhost:3000"
