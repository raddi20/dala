# Local SQLite file, resolved relative to the prisma/ directory.
# On Vercel set this to a Neon Postgres URL instead, with sslmode=require.
DATABASE_URL="file:./dev.db"

# Auth.js session signing key. Use a long random value in production.
AUTH_SECRET="dala-dev-secret-change-me"
AUTH_TRUST_HOST=true

# Production admin (Vercel Production, and Preview if preview deploys share the database).
# Sign-up does not verify that the person owns the mailbox, so registering this address does not grant admin.
# The production build creates the account when it is missing. The first password is ADMIN_CLAIM_SECRET.
# If the address was already registered, that same build replaces the password and then sets role admin.
# Deploys after that leave the admin password and profile alone.
# Comma-separated list is allowed. Matching is case-insensitive. Leave unset to promote nobody.
# ADMIN_EMAIL="admin@rangach.co.ke"
# 16 to 72 characters. This is the login password. Example: openssl rand -base64 24
# ADMIN_CLAIM_SECRET=""
# Set to 1 for a single production deploy when you need to replace that password, then delete it.
# ADMIN_CLAIM_RESET=

# Production only, after Vercel assigns a URL. Same origin, no path.
# AUTH_URL="https://dala-sigma.vercel.app"
# NEXTAUTH_URL="https://dala-sigma.vercel.app"

# Public site name. Optional. Defaults to Rangach.
# Set this in Vercel (Production, and Preview if preview URLs should use another name) and redeploy.
# APP_NAME="Rangach"

# Public site origin, no path and no trailing slash.
# Used for metadataBase, canonical and Open Graph URLs, WhatsApp and share links, and the Flutterwave return URL.
# Read in this order: APP_URL, then AUTH_URL, then NEXTAUTH_URL.
# When none are set, share links and the payment return URL use the request host, and setup copy falls back to https://dala-sigma.vercel.app.
# After rangach.co.ke is attached, set APP_URL (and AUTH_URL and NEXTAUTH_URL) to https://rangach.co.ke and redeploy.
# APP_URL="https://dala-sigma.vercel.app"

# Seeded @dala.local shops and listings stay visible on public pages.
# Set to 1, true, yes, or on to hide them. The rows stay in the database.
# Placeholder phone and WhatsApp numbers are never shown, even while the shops are visible.
# HIDE_DEMO_SHOPS=1

# Paid upgrades (Featured and Verified Pro). Off unless set to 1, true, yes, or on.
# While off, pay, promote, and upgrade buttons say "Paid upgrades coming soon" and checkout creation is refused.
# The pricing page still shows the plans and prices, labelled Coming soon.
# Webhooks and /upgrade/return still reconcile a payment already in flight.
# Admin Grant, Add 30 days, and Remove keep working. Set this to 1 to restore checkout exactly.
# PAYMENTS_LIVE=

# Flutterwave checkout for Featured listing and Verified Pro.
# Leave these unset to keep checkout disabled. Nothing is charged until a secret key is set.
# Test secret keys start with FLWSECK_TEST. Live keys start with FLWSECK- and take real money.
# FLW_SECRET_KEY="FLWSECK_TEST-..."
# FLW_PUBLIC_KEY="FLWPUBK_TEST-..."
# The same string you save as the webhook secret hash in the Flutterwave dashboard.
# FLW_WEBHOOK_HASH="a-long-random-string"
# Local return URL. Omit to use the dev server host. See APP_URL above.

# Vercel Blob read-write token for seller photo upload (listing, offering, shop cover, profile).
# In the Vercel project: Storage → Blob → create a store and connect it to this project.
# Vercel sets BLOB_READ_WRITE_TOKEN. Do not commit the token.
# Leave it unset to keep device upload disabled. Pasted http(s) photo URLs still save.
# BLOB_READ_WRITE_TOKEN=

# Shop video (Mux). Leave every MUX_ var unset to hide uploads and keep the rest of the site working.
# Do not set MUX_MOCK on Vercel.
# MUX_TOKEN_ID and MUX_TOKEN_SECRET: Mux dashboard → Settings → Access Tokens. Mux Video read and write. Production.
# MUX_WEBHOOK_SECRET: Mux dashboard → Settings → Webhooks → the signing secret for https://www.rangach.co.ke/api/mux/webhook
# MUX_SIGNING_KEY_ID and MUX_SIGNING_PRIVATE_KEY: Mux dashboard → Settings → Signing Keys. The private key is the base64 value Mux shows once.
# MUX_AI_MODERATION: set to 1 to run Mux Robots moderate as advice for the admin. Off when unset. A person still approves.
# MUX_MOCK: set to 1 on your laptop only. Fakes upload, webhooks, and playback. No Mux calls.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=
# MUX_AI_MODERATION=
# MUX_MOCK=

# AI features (all off by default).
# Leave every flag unset and the site behaves as it does today. Do not set AI_PROVIDER=mock in Production.
# Preview may set AI_PROVIDER=mock so the admin page can be opened without a paid key.
# GEMINI_API_KEY comes from aistudio.google.com on the paid tier. OPENAI_API_KEY is an optional backup.
# AI_MONTHLY_BUDGET_USD=10 stops calls at that cap. STATS_SALT is a long random string. No IP address is stored.
# AI_PROVIDER=gemini
# AI_MODEL_PRIMARY=gemini-3.5-flash-lite
# AI_MODEL_FAST=gemini-3.1-flash-lite
# AI_MONTHLY_BUDGET_USD=10
# AI_TIMEOUT_MS=8000
# AI_MAX_RETRIES=1
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# AI_FALLBACK_PROVIDER=
# AI_FALLBACK_MODEL=
# AI_BASE_URL=
# AI_API_KEY=
# AI_PRICE_IN_PER_M=
# AI_PRICE_OUT_PER_M=
# AI_COMPAT_VISION=
# AI_COMPAT_JSON_MODE=
# AI_MODEL_LISTING_WRITER=
# AI_MODEL_SMART_SEARCH=
# AI_MODEL_FAMILY_HELPER=
# AI_MODEL_MODERATION=
# AI_MODEL_SELLER_TIPS=
# AI_LISTING_WRITER=
# AI_SMART_SEARCH=
# AI_FAMILY_HELPER=
# AI_MODERATION=
# MOD_PHOTO_HASH=1 turns on photo fingerprints. Unset skips them. The value is not a secret.
# A fingerprint is the raw 64-bit dHash. Photos within 6 bits are the same picture.
# Candidates are looked up by four 16-bit chunks. The same seller reusing a photo is not flagged.
# MOD_PHOTO_HASH=
# AI_SELLER_TIPS=1 lets the Monday 05:00 UTC cron draft a tip. Unset drafts nothing.
# AI_SELLER_TIPS=
# TIPS_EMAIL=1 is also required before any email is sent, and the seller must opt in. Unset sends nothing.
# TIPS_EMAIL=
# ZEPTOMAIL_TOKEN is the Send Mail token from ZeptoMail (Mail Agents → SMTP/API). It starts with the Zoho key.
# ZEPTOMAIL_TOKEN=
# EMAIL_FROM is a sender on a domain you have verified in ZeptoMail, for example "Rangach <hello@rangach.co.ke>".
# EMAIL_FROM=
# CRON_SECRET is a long random string (openssl rand -base64 32). Vercel sends it as Authorization: Bearer on the cron request.
# CRON_SECRET=
# STATS_TRACKING=
# STATS_SALT=
