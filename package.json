{
  "name": "dala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sw.mjs && next build",
    "build:vercel": "node scripts/prepare-db-provider.mjs && prisma generate && node scripts/db-push.mjs && node --import tsx scripts/backfill-pro-until.ts && node scripts/seed-if-empty.mjs && node --import tsx scripts/secure-accounts.ts && node scripts/build-sw.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file=.env --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@mux/mux-node": "^15.4.0",
    "@mux/mux-player-react": "^3.13.4",
    "@mux/upchunk": "^3.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.6.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "uqr": "^0.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsqr": "^1.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
