generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  kind         String   @default("person")
  bio          String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("")
  city         String   @default("Nairobi")
  avatarUrl    String   @default("")
  verifiedPro  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings         Listing[]
  reviews          Review[]
  reportsMade      Report[]  @relation("Reporter")
  reportsReceived  Report[]  @relation("ReportTarget")
  blocksMade       Block[]   @relation("Blocker")
  blocksReceived   Block[]   @relation("Blocked")
  payments         Payment[]
  storefront       Storefront?
}

model Listing {
  id              String    @id @default(cuid())
  type            String
  title           String
  description     String
  category        String
  city            String
  region          String
  address         String    @default("")
  priceLabel      String    @default("")
  contactName     String    @default("")
  contactPhone    String    @default("")
  contactWhatsapp String    @default("")
  photoUrl        String    @default("")
  verified        Boolean   @default(false)
  featured        Boolean   @default(false)
  featuredUntil   DateTime?
  hidden          Boolean   @default(false)
  scamRisk        String    @default("low")
  scamNotes       String    @default("")
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviews         Review[]
  reports         Report[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([city])
  @@index([region])
  @@index([category])
  @@index([type])
  @@index([hidden])
  @@index([ownerId])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  authorId  String
  rating    Int
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([listingId, authorId])
  @@index([listingId])
}

model Report {
  id           String   @id @default(cuid())
  listingId    String?
  targetUserId String?
  reporterId   String
  reason       String
  details      String   @default("")
  status       String   @default("open")
  createdAt    DateTime @default(now())
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Storefront {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String     @unique
  bannerUrl String     @default("")
  published Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  offerings Offering[]

  @@index([published])
}

model Offering {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  priceCents   Int?
  currency     String     @default("")
  imageUrl     String     @default("")
  sortOrder    Int        @default(0)
  archived     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([storefrontId, archived])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  listingId String?
  product   String
  method    String
  amount    String
  reference String
  status    String   @default("paid")
  note      String   @default("Simulated. No charge was made.")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}
