generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Git keeps this datasource on SQLite so local npm run db:setup stays a file database.
// The Vercel build switches the datasource to Postgres when DATABASE_URL is a postgres URL.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  kind         String   @default("person")
  bio          String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("")
  city         String   @default("Nairobi")
  avatarUrl    String   @default("")
  verifiedPro  Boolean  @default(false)
  // End of the paid Pro plan. Null while verifiedPro is on means a shop that
  // paid before expiry existed. The deploy backfill writes a 30-day grace date.
  // Until that runs, isProActive treats the row as still on so nobody loses Pro.
  verifiedProUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings         Listing[]
  reviews          Review[]
  reportsMade      Report[]  @relation("Reporter")
  reportsReceived  Report[]  @relation("ReportTarget")
  blocksMade       Block[]   @relation("Blocker")
  blocksReceived   Block[]   @relation("Blocked")
  payments         Payment[]
  storefront       Storefront?
  shopBadgeEvents  ShopBadgeEvent[]
}

model Listing {
  id              String    @id @default(cuid())
  type            String
  title           String
  description     String
  category        String
  city            String
  region          String
  address         String    @default("")
  priceLabel      String    @default("")
  contactName     String    @default("")
  contactPhone    String    @default("")
  contactWhatsapp String    @default("")
  photoUrl        String    @default("")
  verified        Boolean   @default(false)
  featured        Boolean   @default(false)
  featuredUntil   DateTime?
  hidden          Boolean   @default(false)
  scamRisk        String    @default("low")
  scamNotes       String    @default("")
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviews         Review[]
  reports         Report[]
  payments        Payment[]
  occasions       ListingOccasion[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([city])
  @@index([region])
  @@index([category])
  @@index([type])
  @@index([hidden])
  @@index([ownerId])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  authorId  String
  rating    Int
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([listingId, authorId])
  @@index([listingId])
}

model Report {
  id           String   @id @default(cuid())
  listingId    String?
  targetUserId String?
  reporterId   String
  reason       String
  details      String   @default("")
  status       String   @default("open")
  createdAt    DateTime @default(now())
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Storefront {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String   @unique
  bannerUrl        String   @default("")
  published        Boolean  @default(false)
  // Admin-granted shop checks. Independent of the paid Pro plan (User.verifiedPro).
  phoneVerified    Boolean  @default(false)
  locationVerified Boolean  @default(false)
  businessVerified Boolean  @default(false)
  // Seller opt-in: this shop will take a WhatsApp order from abroad for family at home.
  servesDiaspora   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  offerings        Offering[]
  badgeEvents      ShopBadgeEvent[]
  occasions        ShopOccasion[]
  videos           ShopVideo[]
  videoEvents      ShopVideoEvent[]

  @@index([published])
  @@index([servesDiaspora])
}

// A public collection such as weddings or Christmas at home.
// Bootstrap inserts a row only when the slug is missing. It never rewrites title or intro.
model Occasion {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  intro     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     ShopOccasion[]
  listings  ListingOccasion[]
}

model ShopOccasion {
  id           String     @id @default(cuid())
  occasionId   String
  storefrontId String
  pinned       Boolean    @default(false)
  pinOrder     Int        @default(0)
  createdAt    DateTime   @default(now())
  occasion     Occasion   @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([occasionId, storefrontId])
  @@index([occasionId, pinned])
}

model ListingOccasion {
  id         String   @id @default(cuid())
  occasionId String
  listingId  String
  pinned     Boolean  @default(false)
  pinOrder   Int      @default(0)
  createdAt  DateTime @default(now())
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([occasionId, listingId])
  @@index([occasionId, pinned])
}

// Append-only record of shop badge grants and removals. The app only inserts rows.
model ShopBadgeEvent {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  // phone, location, or business
  badge        String
  // grant or remove
  action       String
  // call, video, visit, or documents on a grant. Empty on a removal.
  // documents means the admin looked at papers. Nothing is uploaded or stored.
  method       String     @default("")
  note         String     @default("")
  adminId      String
  admin        User       @relation(fields: [adminId], references: [id], onDelete: Restrict)
  adminEmail   String     @default("")
  adminName    String     @default("")
  createdAt    DateTime   @default(now())

  @@index([storefrontId, createdAt])
  @@index([adminId])
}

// One shop can have a live video and, at the same time, a replacement that is still in review.
// Rows are kept after rejection so the audit note and poster remain. Mux assets are deleted separately.
model ShopVideo {
  id               String     @id @default(cuid())
  storefrontId     String
  storefront       Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  // uploading, processing, pending, approved, rejected, errored, replaced
  status           String     @default("uploading")
  uploadId         String     @default("")
  assetId          String     @default("")
  // Signed playback id. Used for admin review. Empty until Mux finishes the asset.
  playbackId       String     @default("")
  // Public playback id. Set only when an admin approves. Empty keeps the video private.
  publicPlaybackId String     @default("")
  durationSeconds  Float?
  sizeBytes        Int        @default(0)
  caption          String     @default("")
  posterUrl        String     @default("")
  consentAt        DateTime?
  consentVersion   String     @default("")
  rejectReason     String     @default("")
  rejectedAt       DateTime?
  // Rejected assets are deleted from Mux once this time has passed. Null when already deleted or not rejected.
  purgeAfter       DateTime?
  muxDeletedAt     DateTime?
  // Advisory AI check. Empty when the check is off. Never approves or rejects on its own.
  aiStatus         String     @default("")
  aiDetail         String     @default("")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([storefrontId, status])
  @@index([storefrontId, createdAt])
  @@index([uploadId])
  @@index([assetId])
  @@index([status, purgeAfter])
}

// Append-only. The app only inserts rows. System events (too long, Mux error) leave the admin fields empty.
model ShopVideoEvent {
  id           String   @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  videoId      String   @default("")
  // upload, approve, reject, replace, remove, error
  action       String
  note         String   @default("")
  adminId      String   @default("")
  adminEmail   String   @default("")
  adminName    String   @default("")
  createdAt    DateTime @default(now())

  @@index([storefrontId, createdAt])
}

// Mux webhook deliveries. The id is Mux's event id so a repeat delivery is ignored.
model MuxEventReceipt {
  id        String   @id
  type      String   @default("")
  createdAt DateTime @default(now())
}

model Offering {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  priceCents   Int?
  currency     String     @default("")
  imageUrl     String     @default("")
  sortOrder    Int        @default(0)
  archived     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([storefrontId, archived])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  listingId   String?
  product     String
  method      String
  amount      String
  // Major units that match the label: 1500 for KES 1,500, 12 for £12.
  amountValue Int      @default(0)
  currency    String   @default("")
  reference   String   @unique
  // flutterwave for checkout, simulated for seeded historical receipts.
  provider    String   @default("")
  providerId  String   @default("")
  // pending, paid, failed, cancelled
  status      String   @default("pending")
  note        String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

// ===== AI features (Rob) — additive block, keep at end of file =====
// New tables only. No fields on existing models and no @relation to User, Listing, or Storefront.
// Shop videos (PR #16) adds ShopVideo, ShopVideoEvent, and MuxEventReceipt in its own block.
// These tables do not reference those models. Either migration can apply first.

model AiUsage {
  id            String   @id @default(cuid())
  feature       String
  provider      String
  model         String
  userId        String   @default("")
  actorHash     String   @default("")
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costMicroUsd  Int      @default(0)
  ok            Boolean  @default(true)
  // Short kind: timeout, model_not_found, bad_request, auth, and the other AiError kinds.
  error         String   @default("")
  // Provider status and message for a failed call. Null on success. Never the key or the prompt.
  errorDetail   String?
  latencyMs     Int      @default(0)
  attempt       Int      @default(1)
  isFallback    Boolean  @default(false)
  promptVersion String   @default("")
  estimated     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([actorHash, createdAt])
}

model AiFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  updatedById String   @default("")
  updatedAt   DateTime @updatedAt
}

model StatEvent {
  id           String   @id @default(cuid())
  kind         String
  listingId    String   @default("")
  storefrontId String   @default("")
  sessionHash  String
  createdAt    DateTime @default(now())

  @@index([storefrontId, createdAt])
  @@index([listingId, createdAt])
  @@index([createdAt])
}

model AiSearchCache {
  queryKey   String   @id
  resultJson String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model AiListingDraft {
  id             String   @id @default(cuid())
  userId         String   @default("")
  listingId      String   @default("")
  inputText      String
  photoUrl       String   @default("")
  language       String   @default("en")
  suggestionJson String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model SellerAiPrefs {
  userId         String    @id
  aiConsentAt    DateTime?
  language       String    @default("en")
  tipsEmailOptIn Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
}

model ModerationFlag {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  source       String
  kind         String
  severity     String    @default("medium")
  reason       String    @default("")
  evidenceJson String    @default("{}")
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationReview {
  id         String   @id @default(cuid())
  flagId     String
  action     String
  note       String   @default("")
  adminId    String
  adminEmail String   @default("")
  createdAt  DateTime @default(now())

  @@index([flagId, createdAt])
}

model MediaHash {
  id        String   @id @default(cuid())
  mediaType String
  ownerType String
  ownerId   String
  ownerUser String   @default("")
  url       String
  dhash     String
  h0        String
  h1        String
  h2        String
  h3        String
  createdAt DateTime @default(now())

  @@index([h0])
  @@index([h1])
  @@index([h2])
  @@index([h3])
  @@index([ownerType, ownerId])
}

model SellerTip {
  id           String    @id @default(cuid())
  userId       String
  storefrontId String    @default("")
  weekStart    DateTime
  statsJson    String
  tipsJson     String    @default("")
  source       String    @default("ai")
  emailedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, weekStart])
}

// ===== end AI block =====
